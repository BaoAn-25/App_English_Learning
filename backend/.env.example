# Cổng chạy Web Server
PORT=3000

# Chuỗi kết nối Neon PostgreSQL Database (Lấy từ Neon.tech)
# Ví dụ: postgresql://username:password@ep-cool-butterfly-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-xyz-123.neon.tech/neondb?sslmode=require

# Khóa bí mật ký JWT Token (Bắt buộc trong môi trường sản xuất)
JWT_SECRET=thpt_english12_random_strong_secret_key_change_me_in_production

# Google OAuth 2.0 Web Client ID để xác thực Google Sign-In
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cấu hình máy chủ gửi thư điện tử SMTP (Dùng cho Xác minh Email & Quên mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_app_password
SMTP_FROM="English 12 Support" <support@yourdomain.com>

# Địa chỉ Web hoặc Domain phục vụ các đường link xác thực và đặt lại mật khẩu
APP_URL=https://english12-backend.onrender.com

# Khóa API Google Gemini AI cho Trợ lý Gia sư AI (Tùy chọn)
# Lấy từ Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
